      yoyo: true,
      ease: "none",
      immediateRender: false
    }, 0);

  loop.add(boxTimeline, index * stagger);
});

const cycleDuration = stagger * boxes.length;
const loopHead = gsap.fromTo(loop, { totalTime: cycleDuration + duration * 0.5 }, {
  totalTime: `+=${cycleDuration}`,
  duration: 1,
  ease: "none",
  repeat: -1,
  paused: true
});
const playhead = { position: 0 };
const wrapPosition = gsap.utils.wrap(0, loopHead.duration());
const scrub = gsap.to(playhead, {
  position: 0,
  paused: true,
  duration: 0.25,
  ease: "power3",
  onUpdate: () => loopHead.totalTime(wrapPosition(playhead.position))
});

const trigger = ScrollTrigger.create({
  trigger: ".album-carousel",
  start: "top top",
  end: "bottom bottom",
  pin: ".album-carousel .boxes",
  onUpdate: self => {
    scrub.vars.position = self.progress * loopHead.duration();
    scrub.invalidate().restart();
  }
});

const snap = gsap.utils.snap(1 / boxes.length);
const progressToScroll = progress => gsap.utils.clamp(
  trigger.start + 1,
  trigger.end - 1,
  gsap.utils.clamp(0, 1, progress) * (trigger.end - trigger.start) + trigger.start
);
const scrollToPosition = position => {
  const snappedPosition = gsap.utils.clamp(0, loopHead.duration(), snap(position));
  const progress = snappedPosition / loopHead.duration();
  trigger.scroll(progressToScroll(progress));
};

const next = () => scrollToPosition(scrub.vars.position - 1 / boxes.length);
const previous = () => scrollToPosition(scrub.vars.position + 1 / boxes.length);

document.addEventListener("keydown", event => {
  if (event.code === "ArrowLeft" || event.code === "KeyA") next();
  if (event.code === "ArrowRight" || event.code === "KeyD") previous();
});

document.querySelector(".album-carousel .next")?.addEventListener("click", next);
document.querySelector(".album-carousel .prev")?.addEventListener("click", previous);
document.querySelector(".album-carousel .boxes")?.addEventListener("click", event => {
  const box = event.target.closest(".box");
  if (!box) return;

  const target = boxes.indexOf(box);
  const current = gsap.utils.wrap(0, boxes.length, Math.floor(boxes.length * scrub.vars.position));
  let bump = target - current;
  if (target > current && target - current > boxes.length * 0.5) bump = (boxes.length - bump) * -1;
  if (current > target && current - target > boxes.length * 0.5) bump = boxes.length + bump;
  scrollToPosition(scrub.vars.position + bump * (1 / boxes.length));
});

gsap.set(".album-carousel .box", { display: "block" });
gsap.set(".album-carousel button", { z: 200 });

Draggable.create(".album-carousel .drag-proxy", {
  type: "x",
  trigger: ".album-carousel .box",
  onPress() {
    this.startOffset = scrub.vars.position;
  },
  onDrag() {
    scrub.vars.position = gsap.utils.clamp(
      0,
      loopHead.duration(),
      this.startOffset + (this.startX - this.x) * 0.001
    );
    scrub.invalidate().restart();
  },
  onDragEnd() {
    scrollToPosition(scrub.vars.position);
  }
});
</script>