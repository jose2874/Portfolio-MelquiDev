---
import Layout from '../layouts/Layout.astro';

const projects = [
	{ number: '01', title: 'Lumen / Digital journal', description: 'Una experiencia editorial para leer más despacio y guardar lo que importa.', tags: ['Dirección de arte', 'Web design'], image: 'https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?auto=format&fit=crop&w=1200&q=85', className: 'project--wide' },
	{ number: '02', title: 'Noma / Objects with intent', description: 'Identidad y e-commerce para una colección de objetos cotidianos.', tags: ['Branding', 'E-commerce'], image: 'https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?auto=format&fit=crop&w=900&q=85', className: 'project--tall' },
	{ number: '03', title: 'Marea / Studio notes', description: 'Un sistema visual flexible para un estudio que trabaja con materia.', tags: ['Identidad', 'Estrategia'], image: 'https://images.unsplash.com/photo-1513364776144-60967b0f800f?auto=format&fit=crop&w=900&q=85', className: 'project--square' },
];
---

<Layout>
	<div class="site-shell">
		<header class="nav-wrap"><a class="wordmark" href="#top" aria-label="Volver al inicio">M<span>.</span></a><nav aria-label="Navegación principal"><a href="#work">Trabajo</a><a href="#about">Sobre mí</a><a href="#contact">Contacto</a></nav><a class="availability" href="#contact"><i></i> Disponible para proyectos</a></header>
		<main id="top">
			<section class="hero section-pad"><div class="hero-kicker"><span>Desarrollador Full Stack</span><span>Barcelona · ES</span></div><div class="hero-content"><p class="eyebrow">Hey, soy Melqui.</p><h1>Diseño ideas<br /><em>que se sienten.</em></h1><div class="hero-bottom"><p class="intro">Diseñador multidisciplinar creando identidades, productos digitales y espacios de marca con una mirada clara y humana.</p><a class="circle-link" href="#work" aria-label="Ver selección de trabajo"><span>↓</span></a></div></div><div class="hero-stamp" aria-hidden="true"><span>Ideas</span><span>con</span><span>intención</span></div></section>
			<section class="work section-pad" id="work"><div class="section-heading"><p class="eyebrow">01 / Selección</p><p class="muted">2023 — 2025</p></div><div class="work-intro"><h2>Trabajo que<br /><em>deja huella.</em></h2><p>Colaboro con personas y equipos que quieren hacer las cosas un poco mejor. Desde el primer concepto hasta el último píxel.</p></div><div class="project-grid">{projects.map((project) => <article class={`project ${project.className}`}><a class="project-image" href="#contact" aria-label={`Ver proyecto ${project.title}`}><img src={project.image} alt="" loading="lazy" /><span class="view-project">Ver proyecto ↗</span></a><div class="project-meta"><span>{project.number}</span><div><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div></div></div></article>)}</div></section>
			<section class="about section-pad" id="about"><div class="section-heading"><p class="eyebrow">02 / En pocas palabras</p><p class="muted">Un poco de contexto</p></div><div class="about-grid"><h2>Diseño con<br /><em>los pies en la tierra.</em></h2><div class="about-copy"><p>Trabajo entre la estrategia y la forma. Me interesa encontrar ese punto exacto donde una idea puede ser útil, bella y fácil de recordar.</p><p>Cuando no estoy diseñando, probablemente estoy fotografiando detalles, buscando libros o preparando café para demasiadas personas.</p><a class="text-link" href="mailto:hola@melqui.dev">Hablemos <span>↗</span></a></div></div></section>
			<section class="contact section-pad" id="contact"><div class="contact-top"><p class="eyebrow">03 / Contacto</p><p class="muted">¿Tienes algo en mente?</p></div><h2>Hagamos algo<br /><em>con sentido.</em></h2><a class="contact-email" href="mailto:hola@melqui.dev">hola@melqui.dev <span>↗</span></a></section>
		</main>
		<footer><span>© 2025 Melqui Dev</span><div><a href="https://www.linkedin.com/in/melqui-cabezas-canales-975a0a331/" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="https://www.instagram.com" target="_blank" rel="noreferrer">Instagram ↗</a></div><span>Hecho con intención.</span></footer>
	</div>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap');
	:global(*) { box-sizing: border-box; } :global(html) { scroll-behavior: smooth; } :global(body) { background: #f2eee7; color: #20201d; font-family: 'DM Sans', sans-serif; }
	.site-shell { overflow: hidden; } .section-pad, .nav-wrap, footer { max-width: 1280px; margin: 0 auto; padding-left: clamp(24px, 5vw, 76px); padding-right: clamp(24px, 5vw, 76px); }
	.nav-wrap { height: 92px; display: flex; align-items: center; justify-content: space-between; font-size: 13px; } .wordmark { color: #20201d; font-family: 'Playfair Display', serif; font-size: 34px; text-decoration: none; line-height: 1; } .wordmark span { color: #e5593f; } nav { display: flex; gap: clamp(20px, 3vw, 46px); margin-left: 10%; } nav a, .availability, footer a { color: #20201d; text-decoration: none; } nav a:hover, footer a:hover { color: #e5593f; } .availability { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: .04em; text-transform: uppercase; } .availability i { display: inline-block; width: 7px; height: 7px; margin-right: 8px; border-radius: 50%; background: #e5593f; }
	.hero { min-height: calc(100vh - 92px); position: relative; padding-top: clamp(55px, 11vh, 130px); padding-bottom: 70px; } .hero-kicker, .section-heading, .contact-top { display: flex; justify-content: space-between; color: #77736d; font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: .04em; text-transform: uppercase; } .hero-kicker span:first-child { color: #e5593f; } .hero-content { position: relative; z-index: 1; max-width: 850px; margin-top: 9vh; } .eyebrow { color: #e5593f; font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; } .hero h1 { margin: 22px 0 48px; font-family: 'Playfair Display', serif; font-size: clamp(64px, 10vw, 148px); font-weight: 500; letter-spacing: -.045em; line-height: .9; } .hero h1 em, h2 em { color: #e5593f; font-style: italic; } .hero-bottom { display: flex; align-items: flex-end; justify-content: space-between; max-width: 660px; } .intro { max-width: 310px; margin: 0; color: #68645e; font-size: 16px; line-height: 1.55; } .circle-link { display: grid; width: 76px; height: 76px; place-items: center; border: 1px solid #a8a199; border-radius: 50%; color: #20201d; text-decoration: none; font-size: 24px; transition: .25s ease; } .circle-link:hover { background: #e5593f; border-color: #e5593f; color: #f2eee7; transform: rotate(-35deg); } .hero-stamp { position: absolute; right: 8%; bottom: 9%; display: grid; width: 142px; height: 142px; place-content: center; border: 1px solid #c2bbb1; border-radius: 50%; color: #77736d; font-family: 'DM Mono', monospace; font-size: 10px; line-height: 1.5; text-align: center; text-transform: uppercase; transform: rotate(12deg); }
	.work { padding-top: 120px; padding-bottom: 150px; } .section-heading { border-top: 1px solid #cfc8bd; padding-top: 15px; } .muted { color: #77736d; } .work-intro { display: grid; grid-template-columns: 1.15fr 1fr; align-items: end; gap: 10%; margin: 75px 0 100px; } .work h2, .about h2 { margin: 0; font-family: 'Playfair Display', serif; font-size: clamp(48px, 6vw, 88px); font-weight: 500; letter-spacing: -.045em; line-height: .95; } .work-intro > p { max-width: 330px; margin: 0 0 5px; color: #68645e; font-size: 16px; line-height: 1.6; } .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 100px 28px; } .project--wide { grid-column: span 2; max-width: 820px; } .project--tall { margin-top: 100px; } .project-image { position: relative; display: block; overflow: hidden; background: #ddd5ca; aspect-ratio: 1.35; } .project--wide .project-image { aspect-ratio: 2.05; } .project--tall .project-image { aspect-ratio: .88; } .project-image img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.78); transition: transform .6s ease, filter .6s ease; } .project-image:hover img { filter: saturate(1); transform: scale(1.04); } .view-project { position: absolute; right: 18px; bottom: 18px; padding: 12px 14px; background: #f2eee7; color: #20201d; font-family: 'DM Mono', monospace; font-size: 10px; text-transform: uppercase; opacity: 0; transform: translateY(8px); transition: .25s ease; } .project-image:hover .view-project { opacity: 1; transform: translateY(0); } .project-meta { display: grid; grid-template-columns: 34px 1fr; gap: 12px; padding-top: 18px; } .project-meta > span { color: #e5593f; font-family: 'DM Mono', monospace; font-size: 11px; } .project-meta h3 { margin: 0 0 8px; font-family: 'Playfair Display', serif; font-size: 25px; font-weight: 500; } .project-meta p { max-width: 350px; margin: 0 0 14px; color: #77736d; font-size: 13px; line-height: 1.5; } .tags { display: flex; gap: 7px; flex-wrap: wrap; } .tags span { border: 1px solid #c9c1b7; border-radius: 99px; padding: 6px 9px; color: #77736d; font-family: 'DM Mono', monospace; font-size: 9px; text-transform: uppercase; }
	.about { padding-top: 110px; padding-bottom: 160px; border-top: 1px solid #cfc8bd; } .about-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 10%; margin-top: 90px; } .about-copy { max-width: 420px; padding-top: 8px; } .about-copy p { margin: 0 0 22px; color: #68645e; font-size: 17px; line-height: 1.65; } .text-link { display: inline-flex; gap: 20px; margin-top: 25px; border-bottom: 1px solid #20201d; padding-bottom: 8px; color: #20201d; font-size: 14px; text-decoration: none; } .text-link span { color: #e5593f; }
	.contact { padding-top: 90px; padding-bottom: 115px; background: #20201d; color: #f2eee7; } .contact-top { color: #99958e; } .contact h2 { margin: 100px 0 55px; font-family: 'Playfair Display', serif; font-size: clamp(60px, 10vw, 145px); font-weight: 500; letter-spacing: -.05em; line-height: .88; } .contact h2 em { color: #e5593f; } .contact-email { display: inline-flex; gap: 28px; border-bottom: 1px solid #77736d; padding-bottom: 12px; color: #f2eee7; font-family: 'DM Mono', monospace; font-size: clamp(15px, 2vw, 22px); text-decoration: none; } .contact-email span { color: #e5593f; } footer { display: flex; justify-content: space-between; padding-top: 25px; padding-bottom: 25px; background: #20201d; color: #99958e; font-family: 'DM Mono', monospace; font-size: 10px; text-transform: uppercase; } footer div { display: flex; gap: 24px; } footer a { color: #99958e; }
	@media (max-width: 700px) { .nav-wrap { height: 76px; } .nav-wrap nav { display: none; } .availability { font-size: 9px; } .hero { min-height: 660px; padding-top: 38px; } .hero-content { margin-top: 85px; } .hero h1 { font-size: clamp(58px, 17vw, 100px); margin: 18px 0 38px; } .hero-bottom { align-items: flex-start; } .circle-link { width: 58px; height: 58px; flex: 0 0 auto; } .hero-stamp { right: -34px; bottom: 30px; opacity: .7; } .work { padding-top: 80px; padding-bottom: 95px; } .work-intro, .about-grid { display: block; margin-top: 55px; } .work-intro > p { margin-top: 30px; } .project-grid { display: block; } .project { margin-top: 65px; } .project--tall { margin-top: 65px; } .project--wide .project-image, .project--tall .project-image { aspect-ratio: 1.1; } .about { padding-top: 75px; padding-bottom: 100px; } .about-copy { margin-top: 35px; } .contact { padding-top: 65px; padding-bottom: 85px; } .contact h2 { margin: 80px 0 45px; font-size: 18vw; } footer { display: block; line-height: 2.3; } footer div { gap: 15px; } footer > span:last-child { display: block; margin-top: 10px; } }
</style>
<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	gsap.registerPlugin(ScrollTrigger);

	const tl = gsap.timeline({
		scrollTrigger: {
			scrub: 1
		}
	});
</script>